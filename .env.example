# UtahRealEstate RESO bearer token. Server only. Never expose this to the browser.
UTAH_MLS_TOKEN=
# Optional override. Default is https://resoapi.utahrealestate.com/reso/odata
UTAH_MLS_BASE_URL=

# Follow Up Boss API key. Leads are created with source "Logan Main QR".
FOLLOW_UP_BOSS_API_KEY=

# Protects the daily market route. Vercel Cron sends this as a bearer token.
CRON_SECRET=

# Optional. When set, the daily job stores the snapshot in Vercel Blob so it
# survives a serverless deploy. Without it, the checked-in starter snapshot is used.
BLOB_READ_WRITE_TOKEN=
