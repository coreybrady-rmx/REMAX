# UtahRealEstate RESO bearer token. Server only. Never expose this to the browser.
UTAH_MLS_TOKEN=
# Optional override. Default is https://resoapi.utahrealestate.com/reso/odata
UTAH_MLS_BASE_URL=

# Follow Up Boss API key. CMA leads are created with source "Logan Main QR"
# and assigned to Eli Hopkins (looked up by name; the user id is not stored here).
FOLLOW_UP_BOSS_API_KEY=

# Protects the daily market route. Vercel Cron sends this as a bearer token.
CRON_SECRET=

# Stores the market snapshot, the scan-by-scan headline counter, and the
# headline submission tally so they survive a serverless deploy. Without it,
# the checked-in starter snapshot is used and each new visitor still sees a
# headline, but the rotation and the submission counts can reset.
BLOB_READ_WRITE_TOKEN=
